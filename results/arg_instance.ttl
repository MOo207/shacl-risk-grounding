@prefix arg: <http://example.org/grc/arg#> .
@prefix grc: <https://w3id.org/grc/ontology#> .
@prefix inst: <http://example.org/grc/instance/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

inst:NFCRM-5-1 a grc:NFCRMControl ;
    grc:controlId "NFCRM-5-1" ;
    grc:controlName "Designate a liaison officer with NCA for cybersecurity risk management activation" ;
    grc:nfcrmClause "NFCRM-1:2025-§5.1" .

inst:NFCRM-5-2 a grc:NFCRMControl ;
    grc:controlId "NFCRM-5-2" ;
    grc:controlName "Inventory and classify all organization assets (sensitive systems, OT, social media accounts, etc.) per NCA guidance, and review classification periodically" ;
    grc:nfcrmClause "NFCRM-1:2025-§5.2" .

inst:NFCRM-5-3 a grc:NFCRMControl ;
    grc:controlId "NFCRM-5-3" ;
    grc:controlName "Inventory internet-facing assets" ;
    grc:nfcrmClause "NFCRM-1:2025-§5.3" .

inst:NFCRM-5-4 a grc:NFCRMControl ;
    grc:controlId "NFCRM-5-4" ;
    grc:controlName "Report identified assets (from 5.2 and 5.3) to NCA periodically via Haseen platform, and update upon any change" ;
    grc:nfcrmClause "NFCRM-1:2025-§5.4" .

inst:NFCRM-5-5 a grc:NFCRMControl ;
    grc:controlId "NFCRM-5-5" ;
    grc:controlName "Report cybersecurity risks at catastrophic (level 5) and high (level 4) levels to NCA immediately upon identification, per the risk assessment matrix (Figure 2), and share treatment plans periodically" ;
    grc:nfcrmClause "NFCRM-1:2025-§5.5" .

inst:NFCRM-5-6 a grc:NFCRMControl ;
    grc:controlId "NFCRM-5-6" ;
    grc:controlName "Address risks, vulnerabilities, and observations received from NCA; report on remediation actions periodically via Haseen platform" ;
    grc:nfcrmClause "NFCRM-1:2025-§5.6" .

inst:NFCRM-6-1 a grc:NFCRMControl ;
    grc:controlId "NFCRM-6-1" ;
    grc:controlName "Develop and operate a continuous program for cybersecurity risk management methodology with dedicated resources" ;
    grc:nfcrmClause "NFCRM-1:2025-§6.1" .

inst:NFCRM-6-10 a grc:NFCRMControl ;
    grc:controlId "NFCRM-6-10" ;
    grc:controlName "Document analysis and assessment results in the cybersecurity risk register" ;
    grc:nfcrmClause "NFCRM-1:2025-§6.10" .

inst:NFCRM-6-11 a grc:NFCRMControl ;
    grc:controlId "NFCRM-6-11" ;
    grc:controlName "Develop cybersecurity risk treatment plans" ;
    grc:nfcrmClause "NFCRM-1:2025-§6.11" .

inst:NFCRM-6-12 a grc:NFCRMControl ;
    grc:controlId "NFCRM-6-12" ;
    grc:controlName "Assess expected residual risk after executing treatment plans to confirm acceptable risk level is reached" ;
    grc:nfcrmClause "NFCRM-1:2025-§6.12" .

inst:NFCRM-6-13 a grc:NFCRMControl ;
    grc:controlId "NFCRM-6-13" ;
    grc:controlName "Make risk treatment decision (accepting, sharing, mitigating, or avoiding) and define related treatment plans" ;
    grc:nfcrmClause "NFCRM-1:2025-§6.13" .

inst:NFCRM-6-14 a grc:NFCRMControl ;
    grc:controlId "NFCRM-6-14" ;
    grc:controlName "Prioritize treatment plans" ;
    grc:nfcrmClause "NFCRM-1:2025-§6.14" .

inst:NFCRM-6-15 a grc:NFCRMControl ;
    grc:controlId "NFCRM-6-15" ;
    grc:controlName "Execute treatment plans" ;
    grc:nfcrmClause "NFCRM-1:2025-§6.15" .

inst:NFCRM-6-16 a grc:NFCRMControl ;
    grc:controlId "NFCRM-6-16" ;
    grc:controlName "Update cybersecurity risk register to include treatment plans and residual risks" ;
    grc:nfcrmClause "NFCRM-1:2025-§6.16" .

inst:NFCRM-6-17 a grc:NFCRMControl ;
    grc:controlId "NFCRM-6-17" ;
    grc:controlName "Develop cybersecurity risk management reports" ;
    grc:nfcrmClause "NFCRM-1:2025-§6.17" .

inst:NFCRM-6-18 a grc:NFCRMControl ;
    grc:controlId "NFCRM-6-18" ;
    grc:controlName "Establish statistical data collection criteria for risk monitoring" ;
    grc:nfcrmClause "NFCRM-1:2025-§6.18" .

inst:NFCRM-6-19 a grc:NFCRMControl ;
    grc:controlId "NFCRM-6-19" ;
    grc:controlName "Monitor treatment plan execution periodically and issue related reports" ;
    grc:nfcrmClause "NFCRM-1:2025-§6.19" .

inst:NFCRM-6-2 a grc:NFCRMControl ;
    grc:controlId "NFCRM-6-2" ;
    grc:controlName "Engage stakeholders in various phases (e.g., cybersecurity supervisory committee, IT department)" ;
    grc:nfcrmClause "NFCRM-1:2025-§6.2" .

inst:NFCRM-6-20 a grc:NFCRMControl ;
    grc:controlId "NFCRM-6-20" ;
    grc:controlName "Re-execute risk management methodology periodically, or per NCA guidance, or upon change in: treatment plans, potential threats, expected scenarios, control implementation status, or digital infrastructure" ;
    grc:nfcrmClause "NFCRM-1:2025-§6.20" .

inst:NFCRM-6-3 a grc:NFCRMControl ;
    grc:controlId "NFCRM-6-3" ;
    grc:controlName "Inventory and classify organization assets" ;
    grc:nfcrmClause "NFCRM-1:2025-§6.3" .

inst:NFCRM-6-8 a grc:NFCRMControl ;
    grc:controlId "NFCRM-6-8" ;
    grc:controlName "Determine acceptable risk level for the organization" ;
    grc:nfcrmClause "NFCRM-1:2025-§6.8" .

inst:NFCRM-6-9 a grc:NFCRMControl ;
    grc:controlId "NFCRM-6-9" ;
    grc:controlName "Conduct inherent risk analysis for all expected risk scenarios and currently applied controls, assessing likelihood and impact per the risk assessment matrix (Figure 2)" ;
    grc:nfcrmClause "NFCRM-1:2025-§6.9" .

